rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /public/{doc} { allow read: if true; }
    match /open_write/{doc} { allow read, create, update, delete: if true; }
    match /blind_write/{doc} { allow create, update, delete: if true; }
    match /signed_in/{doc} { allow read, write: if request.auth != null; }
    match /users/{uid} {
      allow get, update: if request.auth != null && request.auth.uid == uid;
      match /notes/{doc} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    }
    match /admin_only/{doc} { allow read, write: if request.auth != null && request.auth.token.admin == true; }
    match /update_only/{doc} { allow read, update: if true; }
    match /delete_only/{doc} { allow read, delete: if true; }
    match /validated/{doc} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.keys().hasOnly(['title', 'owner']) && request.resource.data.title is string && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    match /locked/{doc} { allow read, write: if false; }
  }
}
