rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /public/{file=**} { allow read: if true; }
    match /open_write/{file=**} { allow read, write: if true; }
    match /users/{uid}/{file=**} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /locked/{file=**} { allow read, write: if false; }
  }
}
